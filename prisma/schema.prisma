// Esquema de la base de datos: cada "model" es una tabla y cada línea una columna.
// Después de cambiar este archivo corré `npm run db:migrate` para aplicar los cambios.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Listas de valores permitidos ----------

enum Role {
  ADMIN // puede crear y administrar cuentas
  MEMBER
}

enum Currency {
  ARS
  USD
}

enum PaymentMethod {
  CASH // efectivo
  DEBIT // débito
  CREDIT // crédito
  TRANSFER // transferencia
}

enum Source {
  WEB
  WHATSAPP
}

// A qué dólar se pagó un gasto en USD (cada uno tiene su cotización)
enum DollarType {
  MEP // dólar bolsa
  BLUE
  OFICIAL
  TARJETA // oficial + percepciones. Ya no se usa con crédito (el banco cobra al oficial): queda para gastos viejos o si se elige a mano
  CRIPTO
}

enum PaymentSourceKind {
  CARD // tarjetas: Visa, Mastercard, Cabal...
  WALLET // billeteras y bancos: Mercado Pago, MODO, Ualá...
}

// ---------- Tablas ----------

model User {
  id                   String        @id @default(cuid())
  name                 String
  email                String        @unique
  passwordHash         String
  phone                String?       @unique // formato internacional sin "+", ej: 5491122334455 (así lo manda WhatsApp)
  role                 Role          @default(MEMBER)
  active               Boolean       @default(true)
  // Va en la cookie de sesión: cambiar la contraseña lo sube y las sesiones abiertas dejan de valer
  sessionVersion       Int           @default(0)
  // Avisos de Chop (se apagan desde "Cuenta")
  notifyCardDue        Boolean       @default(true) // vencimiento de tarjeta: 3 días antes y el día anterior
  notifyWeekly         Boolean       @default(true) // resumen de la semana pasada
  notifyMonthly        Boolean       @default(true) // resumen del mes pasado
  // Preferencias (se cambian desde "Cuenta")
  homePage             String        @default("/dashboard") // pantalla con la que abre la app
  defaultCurrency      Currency      @default(ARS) // moneda en que se ven los totales
  accentColor          String        @default("neutral") // color principal de la app
  defaultPaymentMethod PaymentMethod @default(DEBIT) // medio de pago que se propone primero
  defaultDollarType    DollarType    @default(MEP) // dólar que se propone primero (USD sin crédito)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  expenses       Expense[]
  categories     Category[]
  paymentSources PaymentSource[]
  budgets        Budget[]
  recurring      RecurringExpense[]
  notices        Notice[]
  passwordResets PasswordReset[]
  receipts       Receipt[]
  merchants      Merchant[]

  @@map("users")
}

// Fotos de tickets que se mandan a Chop: Chop las lee y propone el gasto, y la foto queda con el
// gasto para verla en la web. Se guardan en la base (JPEG achicado, ~200 KB), así entran en los
// backups. Si no se llega a guardar ningún gasto con ella, se borra sola al día siguiente.
model Receipt {
  id        String   @id @default(cuid())
  userId    String
  data      Bytes
  mimeType  String
  cuit      String? // CUIT del comercio, si se leyó (11 dígitos, sin guiones): ver merchants.ts
  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([userId, createdAt])
  @@map("receipts")
}

// Comercios conocidos por su CUIT: a qué categoría van sus tickets. Se aprende al guardar un gasto
// con foto de ticket (o al cambiarle la categoría después), y el próximo ticket de ese comercio
// viene con esa categoría puesta. Cada cuenta tiene los suyos (las categorías son por cuenta).
model Merchant {
  id         String   @id @default(cuid())
  userId     String
  cuit       String // 11 dígitos, sin guiones
  categoryId String
  name       String? // el último nombre leído del ticket ("Carrefour")
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, cuit])
  @@map("merchants")
}

// Links de "olvidé mi contraseña". Se guarda el hash (SHA-256) del token, no el token: el token
// solo viaja en el mail. Vence en 1 hora y sirve una sola vez (usedAt).
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_resets")
}

// Intentos fallidos de entrar con contraseña, para frenar a quien pruebe contraseñas al azar
// (ver login-attempts.ts). Va por email y no por cuenta: también cuentan los emails que no existen,
// así el bloqueo no revela cuáles tienen cuenta. Se borran al entrar bien y a los días.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@map("login_attempts")
}

// Avisos de Chop que ya se entregaron, para no repetirlos. Chop los manda cuando la persona le
// escribe (Meta no deja escribir primero sin plantillas pagas). La clave dice qué aviso es:
// "due3:<tarjeta>:<mes>", "due1:<tarjeta>:<mes>", "week:<lunes>" o "month:<mes>".
model Notice {
  id        String   @id @default(cuid())
  userId    String
  key       String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("notices")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  emoji     String? // lo usa Chop en WhatsApp (ahí no hay íconos)
  icon      String? // ícono en blanco y negro para la web (ver src/components/category-icon.tsx)
  keywords  String[] @default([]) // palabras que el bot de WhatsApp asocia a esta categoría
  userId    String // cada cuenta tiene las suyas (las iniciales se copian al crearla)
  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses  Expense[]
  budgets   Budget[]
  recurring RecurringExpense[]
  merchants Merchant[]

  @@unique([userId, name])
  @@map("categories")
}

// Presupuesto mensual (en pesos) que cada cuenta le pone a una categoría.
// Aunque la categoría sea base, el presupuesto es de una sola persona.
model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  amount     Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Si se borra la categoría, su presupuesto se borra con ella
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId]) // un solo presupuesto por categoría y por cuenta
  @@map("budgets")
}

// Tarjetas y billeteras de cada usuario (Visa, Mercado Pago, ...)
model PaymentSource {
  id        String            @id @default(cuid())
  name      String
  kind      PaymentSourceKind
  userId    String
  createdAt DateTime          @default(now())
  // Solo tarjetas de crédito: qué día del mes cierra y vence el resumen (opcionales)
  closingDay Int?
  dueDay     Int?

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses   Expense[]
  statements CardStatement[]
  payments   CardPayment[]
  recurring  RecurringExpense[]

  @@unique([userId, name])
  @@map("payment_sources")
}

model Expense {
  id            String        @id @default(cuid())
  userId        String
  categoryId    String
  amount        Decimal       @db.Decimal(14, 2) // Decimal y no Float: con plata no queremos errores de redondeo
  currency      Currency      @default(ARS)
  paymentMethod PaymentMethod @default(CASH)
  description   String?
  date          DateTime      @db.Date // solo el día, sin hora
  // Con qué tarjeta o billetera se pagó (opcional)
  paymentSourceId String?
  // Compras en cuotas: se guarda un gasto por cuota, todos con el mismo purchaseId
  installments      Int     @default(1)
  installmentNumber Int     @default(1)
  purchaseId        String?
  // Conversión, calculada al guardar con la cotización del día del gasto (no se recalcula
  // después): así la app suma todo en pesos y también puede mostrarlo en dólares.
  dollarType DollarType? // solo en gastos en USD: a qué dólar se pagó
  rate       Decimal?    @db.Decimal(14, 2) // cotización (venta) usada para convertir
  amountArs  Decimal?    @db.Decimal(14, 2) // el gasto en pesos (en los ARS, igual a amount)
  amountUsd  Decimal?    @db.Decimal(14, 2) // el gasto en dólares (en los ARS, al MEP del día)
  // Gasto fijo que lo cargó solo (null si se cargó a mano)
  recurringId String?
  // Foto del ticket (mandada a Chop). En cuotas, todas las cuotas apuntan a la misma foto
  receiptId String?
  source        Source        @default(WEB)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  // Si se borra la tarjeta, los gastos quedan sin tarjeta (no se borran)
  paymentSource PaymentSource? @relation(fields: [paymentSourceId], references: [id], onDelete: SetNull)
  // Si se borra el gasto fijo, los gastos que ya cargó quedan (como cargados a mano)
  recurring     RecurringExpense? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  receipt       Receipt?          @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@unique([recurringId, date]) // un fijo no puede cargar dos gastos el mismo día
  @@index([userId, date])
  @@index([purchaseId])
  @@map("expenses")
}

// Gastos fijos (alquiler, Netflix, gimnasio...): se cargan solos una vez por mes, el día
// elegido, al abrir Inicio o Gastos. Ver src/lib/services/recurring.ts
model RecurringExpense {
  id              String        @id @default(cuid())
  userId          String
  categoryId      String
  amount          Decimal       @db.Decimal(14, 2)
  currency        Currency      @default(ARS)
  dollarType      DollarType? // solo en USD: a qué dólar se paga (la cotización se busca el día que se carga)
  paymentMethod   PaymentMethod @default(DEBIT)
  paymentSourceId String?
  description     String
  day             Int // día del mes (si el mes es más corto, se carga el último día)
  active          Boolean       @default(true) // pausado = no se carga
  lastMonth       String // "2026-09": último mes ya cargado (o salteado); se carga desde el siguiente
  // Cambio de monto "desde el próximo mes" cuando el de este mes todavía no se cargó
  nextAmount      Decimal?      @db.Decimal(14, 2)
  nextAmountFrom  String? // "2026-10": desde qué mes vale nextAmount
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Al borrar una categoría, sus fijos se mueven con los gastos o se borran (ver categories.ts)
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  paymentSource PaymentSource? @relation(fields: [paymentSourceId], references: [id], onDelete: SetNull)
  expenses      Expense[]

  @@index([userId])
  @@map("recurring_expenses")
}

// Resúmenes de tarjeta con fechas corregidas a mano (el banco a veces mueve el cierre unos días).
// Los demás resúmenes usan el día fijo de la tarjeta: ver src/lib/services/card-statements.ts
model CardStatement {
  id              String   @id @default(cuid())
  paymentSourceId String
  month           String // "2026-09": el mes en que cierra ese resumen
  closingDate     DateTime @db.Date
  dueDate         DateTime @db.Date

  // Si se borra la tarjeta, se borran sus correcciones
  paymentSource PaymentSource @relation(fields: [paymentSourceId], references: [id], onDelete: Cascade)

  @@unique([paymentSourceId, month])
  @@map("card_statements")
}

// Resúmenes de tarjeta marcados como pagados (uno por resumen, pago completo).
// No es un gasto: los gastos de la tarjeta ya están cargados uno por uno.
model CardPayment {
  id              String   @id @default(cuid())
  paymentSourceId String
  month           String // "2026-09": el resumen que se pagó (el mes en que cierra)
  paidOn          DateTime @db.Date
  usdPaidIn       Currency @default(ARS) // los dólares del resumen se pagaron en pesos o en dólares
  rate            Decimal? @db.Decimal(14, 2) // dólar con que se pagaron en pesos (si aplica)
  totalArs        Decimal  @db.Decimal(14, 2) // cuánto se pagó en pesos (lo que dijo el banco)
  totalUsd        Decimal  @default(0) @db.Decimal(14, 2) // cuánto se pagó en dólares
  createdAt       DateTime @default(now())

  paymentSource PaymentSource @relation(fields: [paymentSourceId], references: [id], onDelete: Cascade)

  @@unique([paymentSourceId, month])
  @@map("card_payments")
}

// Cotización de cada tipo de dólar por día. Se completa sola desde DolarApi (hoy) y
// ArgentinaDatos (historial): ver src/lib/services/exchange-rates.ts
model ExchangeRate {
  type      DollarType
  date      DateTime   @db.Date
  buy       Decimal    @db.Decimal(14, 2) // compra
  sell      Decimal    @db.Decimal(14, 2) // venta (la que usamos: a cuánto comprás dólares)
  updatedAt DateTime   @updatedAt

  @@id([type, date])
  @@map("exchange_rates")
}

// En qué paso del menú de WhatsApp está cada teléfono (etapa 8)
model WaSession {
  phone     String   @id
  state     String
  data      Json?
  updatedAt DateTime @updatedAt

  @@map("wa_sessions")
}
