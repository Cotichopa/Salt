// Esquema de la base de datos: cada "model" es una tabla y cada línea una columna.
// Después de cambiar este archivo corré `npm run db:migrate` para aplicar los cambios.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Listas de valores permitidos ----------

enum Role {
  ADMIN // puede crear y administrar cuentas
  MEMBER
}

enum Currency {
  ARS
  USD
}

enum PaymentMethod {
  CASH // efectivo
  DEBIT // débito
  CREDIT // crédito
  TRANSFER // transferencia
}

enum Source {
  WEB
  WHATSAPP
}

enum PaymentSourceKind {
  CARD // tarjetas: Visa, Mastercard, Cabal...
  WALLET // billeteras y bancos: Mercado Pago, MODO, Ualá...
}

// ---------- Tablas ----------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?  @unique // formato internacional sin "+", ej: 5491122334455 (así lo manda WhatsApp)
  role         Role     @default(MEMBER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  expenses       Expense[]
  categories     Category[]
  paymentSources PaymentSource[]
  budgets        Budget[]

  @@map("users")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  emoji     String? // lo usa Chop en WhatsApp (ahí no hay íconos)
  icon      String? // ícono en blanco y negro para la web (ver src/components/category-icon.tsx)
  keywords  String[] @default([]) // palabras que el bot de WhatsApp asocia a esta categoría
  userId    String // cada cuenta tiene las suyas (las iniciales se copian al crearla)
  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]
  budgets  Budget[]

  @@unique([userId, name])
  @@map("categories")
}

// Presupuesto mensual (en pesos) que cada cuenta le pone a una categoría.
// Aunque la categoría sea base, el presupuesto es de una sola persona.
model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  amount     Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Si se borra la categoría, su presupuesto se borra con ella
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId]) // un solo presupuesto por categoría y por cuenta
  @@map("budgets")
}

// Tarjetas y billeteras de cada usuario (Visa, Mercado Pago, ...)
model PaymentSource {
  id        String            @id @default(cuid())
  name      String
  kind      PaymentSourceKind
  userId    String
  createdAt DateTime          @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([userId, name])
  @@map("payment_sources")
}

model Expense {
  id            String        @id @default(cuid())
  userId        String
  categoryId    String
  amount        Decimal       @db.Decimal(14, 2) // Decimal y no Float: con plata no queremos errores de redondeo
  currency      Currency      @default(ARS)
  paymentMethod PaymentMethod @default(CASH)
  description   String?
  date          DateTime      @db.Date // solo el día, sin hora
  // Con qué tarjeta o billetera se pagó (opcional)
  paymentSourceId String?
  // Compras en cuotas: se guarda un gasto por cuota, todos con el mismo purchaseId
  installments      Int     @default(1)
  installmentNumber Int     @default(1)
  purchaseId        String?
  source        Source        @default(WEB)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  // Si se borra la tarjeta, los gastos quedan sin tarjeta (no se borran)
  paymentSource PaymentSource? @relation(fields: [paymentSourceId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([purchaseId])
  @@map("expenses")
}

// En qué paso del menú de WhatsApp está cada teléfono (etapa 8)
model WaSession {
  phone     String   @id
  state     String
  data      Json?
  updatedAt DateTime @updatedAt

  @@map("wa_sessions")
}
