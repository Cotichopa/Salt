# Corre la copia de seguridad de la base (scripts/backup-db.sh). La dispara salt-backup.timer.
# Plantilla: deploy/install.sh reemplaza __USER__ y __APP_DIR__ y la copia a /etc/systemd/system/.

[Unit]
Description=Salt: copia de seguridad de la base
After=postgresql.service

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/scripts/backup-db.sh
