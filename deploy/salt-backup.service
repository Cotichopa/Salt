# Corre la copia de seguridad de la base (scripts/backup-db.sh). La dispara salt-backup.timer.
# Instalación en la VM: ver "Backups" en el README.
# ⚠️ Cambiar User y WorkingDirectory por el usuario y la carpeta donde quedó Salt en la VM.

[Unit]
Description=Salt: copia de seguridad de la base
After=postgresql.service

[Service]
Type=oneshot
User=salt
WorkingDirectory=/home/salt/Salt
ExecStart=/home/salt/Salt/scripts/backup-db.sh
