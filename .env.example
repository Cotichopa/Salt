# Copiá este archivo como .env y completá los valores. El .env NUNCA se sube a git.

# --- Base de datos (Docker local) ---
POSTGRES_USER=salt
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=salt
POSTGRES_PORT=5434
DATABASE_URL="postgresql://salt:cambiame@localhost:5434/salt?schema=public"

# --- Login (Auth.js) --- generar con: openssl rand -base64 32
AUTH_SECRET=

# --- WhatsApp Cloud API ---
# Datos de developers.facebook.com → tu app → WhatsApp → Configuración de la API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# El token de verificación lo inventás vos; se pega igual en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v25.0

# --- IA opcional para texto libre (etapa 9) ---
AI_PARSER_ENABLED=false
ANTHROPIC_API_KEY=

# --- Audios: Whisper en esta misma compu (whisper.cpp), ver docs/estado.md ---
# Sin WHISPER_CLI y WHISPER_MODEL, Chop contesta que todavía no escucha audios.
# WHISPER_CLI=/home/<usuario>/whisper/whisper.cpp/build/bin/whisper-cli
# WHISPER_MODEL=/home/<usuario>/whisper/whisper.cpp/models/ggml-small.bin
WHISPER_CLI=
WHISPER_MODEL=
# Hilos del procesador que usa Whisper (por defecto 8)
WHISPER_THREADS=
# Solo para pruebas: carpeta donde guardar una copia de cada audio (vacío = no guarda)
WHISPER_KEEP_DIR=

# --- Cuenta de administrador (la crea `npx prisma db seed`) ---
ADMIN_NAME=Felo
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambiame
ADMIN_PHONE=

# --- Mails ("olvidé mi contraseña") ---
# Cuenta de Gmail con verificación en 2 pasos y una "contraseña de aplicación"
# (https://myaccount.google.com/apppasswords). Sin esto, los mails se muestran en la terminal.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Dirección de la app para armar los links de los mails, sin "/" al final
# (ej: https://salt.estilo.com.ar). Vacío = http://localhost:3001
APP_URL=
